{
  "name": "guardiao-das-ruinas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run tests/unit.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write 'src/**/*.{ts,css}' 'tests/**/*.ts' '*.{json,ts,html}' 'docs/*.md' README.md AGENTS.md '.agents/**/*.md' '.github/**/*.yml'",
    "format:check": "prettier --check 'src/**/*.{ts,css}' 'tests/**/*.ts' '*.{json,ts,html}' 'docs/*.md' README.md AGENTS.md '.agents/**/*.md' '.github/**/*.yml'"
  },
  "dependencies": {
    "three": "^0.180.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@tensorflow-models/hand-pose-detection": "^2.0.1",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-converter": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.0.0",
    "prettier": "^3.9.10"
  }
}
